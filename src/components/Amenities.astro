---
import Icon from './Icon.astro';
import { amenidades } from '../data/aura';
---

<section id="amenidades" aria-labelledby="amenidades-title" class="px-6 py-24 lg:px-16 lg:py-32">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-xl">
      <p data-reveal class="text-sm text-accent">Amenidades</p>
      <h2 id="amenidades-title" data-reveal style="--d:100ms" class="mt-4 text-3xl lg:text-5xl">
        Ocho amenidades para el día a día
      </h2>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        amenidades.map((am, i) => (
          <article data-reveal style={`--d:${(i % 4) * 80}ms`} class="group overflow-hidden rounded-3xl ring-1 ring-ink/10">
            <div class="relative aspect-[4/3] overflow-hidden">
              <img
                src={`${am.foto}${am.foto.endsWith('.webp') ? '' : '.webp'}`}
                alt={am.nombre}
                loading="lazy"
                decoding="async"
                class="size-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:scale-105"
              />
            </div>
            <div class="flex items-center gap-3 bg-bg p-4">
              <Icon name={am.icono} class="size-5 shrink-0 text-accent" />
              <h3 class="text-sm font-medium">{am.nombre}</h3>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
