---
import { brand, links } from '../data/aura';
---

<header class="pointer-events-none fixed inset-x-0 top-0 z-50 flex justify-center px-4 mt-6">
  <div
    class="pointer-events-auto flex w-max items-center gap-4 rounded-full bg-bg/70 py-2 pr-2 pl-4 ring-1 ring-ink/10 backdrop-blur-xl"
  >
    <a href="#inicio" class="font-display text-sm text-ink transition-colors duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:text-accent">
      {brand.name}
    </a>
    <a
      href={links.elegirDepartamento}
      target="_blank"
      rel="noreferrer"
      class="rounded-full bg-accent px-3 py-2 text-sm font-semibold text-ink transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:scale-[1.03] active:scale-[0.98]"
    >
      Elegir mi departamento
    </a>
  </div>
</header>
