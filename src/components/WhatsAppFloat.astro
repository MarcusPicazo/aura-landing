---
import Icon from './Icon.astro';
import { links } from '../data/aura';
---

<a
  href={links.agendarVisita}
  target="_blank"
  rel="noreferrer"
  aria-label="Escríbenos por WhatsApp"
  class="fixed bottom-6 left-6 z-50 flex size-14 items-center justify-center rounded-full bg-accent text-ink shadow-lg shadow-ink/20 ring-1 ring-ink/10 transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:scale-105 active:scale-95"
>
  <Icon name="whatsapp" class="size-7" />
</a>
