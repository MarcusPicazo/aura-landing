---
import Icon from './Icon.astro';
import { asesora, brand, links, nav, ubicacion } from '../data/aura';

const year = new Date().getFullYear();
---

<footer class="px-6 pt-24 pb-28 md:pb-12 lg:px-16">
  <div class="mx-auto max-w-6xl">
    <div class="grid gap-12 md:grid-cols-2 xl:grid-cols-4">
      <div class="flex flex-col gap-4">
        <span class="font-display text-lg">{brand.name}</span>
        <p class="max-w-xs text-sm text-ink/70">{brand.tagline}, en Del Valle Centro, Ciudad de México.</p>
        <nav aria-label="Secciones">
          <ul class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} class="link">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      <div class="flex flex-col gap-2 text-sm">
        <h2 class="font-sans text-xs tracking-widest text-ink/50 uppercase">Ubicación</h2>
        <address>
          {ubicacion.direccion}<br />
          {ubicacion.codigoPostal}
        </address>
        <p class="text-xs text-ink/50">Dirección ilustrativa</p>
      </div>

      <div class="flex flex-col gap-2 text-sm">
        <h2 class="font-sans text-xs tracking-widest text-ink/50 uppercase">Asesora</h2>
        <p>{asesora.nombre}</p>
        <p class="text-ink/70">{asesora.horario}</p>
      </div>

      <div class="flex flex-col gap-2 text-sm">
        <h2 class="font-sans text-xs tracking-widest text-ink/50 uppercase">Contacto</h2>
        <a href={links.agendarVisitaAsesora} class="link inline-flex items-center gap-2 self-start" rel="noopener" target="_blank">
          <Icon name="whatsapp" />
          WhatsApp
        </a>
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-4 border-t border-ink/10 pt-8 text-xs text-ink/50 md:flex-row md:items-center md:justify-between">
      <p>© {year} {brand.name}. Proyecto demostrativo. Imágenes ilustrativas.</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        <li>
          <a href={links.avisoPrivacidad} class="link">
            Aviso de privacidad
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>
