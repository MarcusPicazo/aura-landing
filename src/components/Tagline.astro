---
const text =
  'Del Valle ya tiene todo. Aura le suma la luz, el silencio y los metros cuadrados que la colonia dejó de construir hace veinte años.';
const words = text.split(' ');
---

<section aria-label="Por qué Aura" class="px-6 py-24 lg:px-16 lg:py-32">
  <p data-tagline class="mx-auto max-w-[680px] text-balance font-display text-4xl lg:text-6xl">
    {
      words.map((word, i) => (
        <span class="tagline-word" style={`transition-delay:${i * 35}ms`}>
          {word}{' '}
        </span>
      ))
    }
  </p>
</section>

<script>
  const words = document.querySelectorAll<HTMLElement>('[data-tagline] .tagline-word');
  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('is-in');
        io.unobserve(entry.target);
      }
    },
    { rootMargin: '0px 0px -20% 0px' },
  );
  words.forEach((word) => io.observe(word));
</script>
